# ===== memory-allinone v1.0.0 环境变量模板 =====
# 复制为 .env 后填入实际值：cp .env.example .env

# --- LLM 配置（必填）---
# 默认走阿里云 dashscope（兼容 OpenAI 协议）
LLM_PROVIDER=qwen
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 如改用自托管 OpenAI 兼容 endpoint，例如：
# LLM_API_URL=http://10.0.0.5:9003/v1
# LLM_MODEL=Qwen3-Coder-30B-A3B-Instruct-AWQ
# LLM_API_KEY=no-api-key-required

# --- 语言 ---
MEMORY_LANG=zh
