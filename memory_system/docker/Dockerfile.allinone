FROM docker.1ms.run/library/python:3.11-slim

# 替换为清华源
RUN sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list.d/debian.sources

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    postgresql \
    redis-server \
    supervisor \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 安装 Python 依赖
COPY pyproject.toml .
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -e .

# 复制代码
COPY . .

# 创建数据目录
RUN mkdir -p /var/lib/postgresql/data /var/log/supervisor

# Supervisor 配置
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# 初始化脚本
COPY docker/init.sh /init.sh
RUN chmod +x /init.sh

ENV PYTHONPATH=/app
ENV MEMORY_pg_dsn=postgresql://memory:memory@localhost:5432/memory
ENV MEMORY_redis_url=redis://localhost:6379
ENV MEMORY_llm_provider=qwen
ENV MEMORY_embedding_service_url=http://localhost:8002

EXPOSE 8009

CMD ["/init.sh"]
