FROM docker.1ms.run/beloved70020/bge-m3:latest

# ── 基础镜像自带 ──────────────────────────────────────────────
# Python 3.12, torch 2.5.1 (CUDA), FlagEmbedding, fastapi, uvicorn
# BGE-M3 模型权重在 /app/models/BAAI/bge-m3

USER root

# ── 替换 APT 源为清华源 ──────────────────────────────────────
RUN sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list 2>/dev/null || true

# ── 安装系统依赖 ──────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql \
    postgresql-client \
    redis-server \
    supervisor \
    curl \
    && rm -rf /var/lib/apt/lists/*

# pgvector 扩展（源码编译，匹配容器内 PG 版本）
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    postgresql-server-dev-all \
    git \
    && cd /tmp \
    && git clone --branch v0.8.0 https://github.com/pgvector/pgvector.git \
    && cd pgvector \
    && make && make install \
    && cd / && rm -rf /tmp/pgvector \
    && apt-get purge -y build-essential git \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# ── 安装 uv + Python 依赖 ────────────────────────────────────
RUN pip install --no-cache-dir uv --index-url https://pypi.tuna.tsinghua.edu.cn/simple

RUN uv pip install --system --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
    asyncpg>=0.30.0 \
    "redis[hiredis]>=5.2.0" \
    pgvector>=0.3.5 \
    anthropic>=0.40.0 \
    httpx>=0.27.0 \
    tenacity>=9.0.0 \
    pydantic-settings>=2.6.0 \
    structlog>=24.4.0 \
    prometheus-client>=0.21.0 \
    openai>=1.0.0 \
    aiokafka>=0.11.0 \
    apscheduler>=3.10.4

# ── 复制项目代码 ──────────────────────────────────────────────
WORKDIR /app/memory

COPY api/          api/
COPY llm/          llm/
COPY models/       models/
COPY pipeline/     pipeline/
COPY retrieval/    retrieval/
COPY storage/      storage/
COPY utils/        utils/
COPY config.py     .
COPY embedding_service/embed.py  /app/embed.py

# ── 复制 Docker 配置 ─────────────────────────────────────────
COPY docker/supervisord.allinone.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/init_allinone.sh /init.sh
RUN chmod +x /init.sh

# ── 创建数据目录 ──────────────────────────────────────────────
RUN mkdir -p /var/lib/postgresql/data /var/log/supervisor /var/run/redis /var/lib/redis

# ── 环境变量 ──────────────────────────────────────────────────
ENV PYTHONPATH=/app/memory:/app
ENV PYTHONUNBUFFERED=1

# memory system 配置
ENV MEMORY_pg_dsn=postgresql://memory:memory@localhost:5434/memory
ENV MEMORY_redis_url=redis://localhost:6379
ENV MEMORY_embedding_service_url=http://localhost:8002

# LLM 配置（外部服务，通过环境变量注入）
ENV MEMORY_llm_provider=qwen
ENV MEMORY_qwen_api_url=http://localhost:9003/v1
ENV MEMORY_qwen_api_key=no-api-key-required

# embedding 配置
ENV EMBEDDING_MODEL_ID=BAAI/bge-m3
ENV EMBEDDING_MODEL_LOAD_PATH=/app/models/BAAI/bge-m3
ENV PORT=8002
ENV HOST=0.0.0.0

# 并发控制
ENV PG_PORT=5434
ENV LLM_MAX_CONCURRENT=10
ENV EXTRACT_MAX_CONCURRENT=5

EXPOSE 8010

ENTRYPOINT []
CMD ["/init.sh"]
